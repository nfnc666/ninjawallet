{
  "expo": {
    "name": "Ninja Wallet",
    "slug": "ninjawallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ninjawallet",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#190E23",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Ninja Wallet uses Face ID to unlock your wallet keys."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ninja Wallet uses Face ID to unlock your wallet."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ninjawallet.app"
    },
    "android": {
      "package": "com.ninjawallet.app",
      "adaptiveIcon": {
        "backgroundColor": "#190E23",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
